# Copy to .env and fill in. EVERYTHING is optional — Kural runs fully offline
# (SMS is logged, eval + classification fall back to heuristics) when these are blank.

# --- LLM (optional): free-text classification (demo mode) + the KuralEval judge ---
# Any OpenAI-COMPATIBLE provider works — set key + (base_url) + model. Examples:
#   OpenAI :  LLM_API_KEY=sk-...                                                              LLM_MODEL=gpt-4o-mini
#   Groq   :  LLM_API_KEY=gsk-...  LLM_BASE_URL=https://api.groq.com/openai/v1                LLM_MODEL=llama-3.3-70b-versatile   (free, fast)
#   Gemini :  LLM_API_KEY=...      LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  LLM_MODEL=gemini-2.0-flash  (free tier)
#   Sarvam :  LLM_API_KEY=...      LLM_BASE_URL=https://api.sarvam.ai/v1                       LLM_MODEL=sarvam-m                  (Indic-tuned)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
# (OPENAI_API_KEY / OPENAI_MODEL still work too, for back-compat.)

# --- Plivo: send the citizen confirmation SMS. Blank => SMS is logged only. ---
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_SRC_NUMBER=

# --- Storage ---
KURAL_DB=kural.db
